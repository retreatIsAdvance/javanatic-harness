section.tab.active { display: block; }
.panel {
  background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
  padding: 14px 16px; margin-bottom: 14px;
}
.row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
button.action {
  border: 1px solid var(--accent); background: var(--accent); color: #fff;
  padding: 6px 14px; border-radius: 6px; cursor: pointer; font-size: 13px;
}
button.ghost {
  border: 1px solid var(--line); background: var(--panel); color: var(--ink);
  padding: 6px 14px; border-radius: 6px; cursor: pointer; font-size: 13px;
}
#error-bar {
  display: none; margin: 0 0 12px; padding: 8px 14px; border-radius: 8px;
  background: #fdecea; color: var(--bad); border: 1px solid #f5c6c0; white-space: pre-wrap;
}
#session-list { list-style: none; margin: 10px 0 0; padding: 0; }
#session-list li {
  padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px;
  margin-bottom: 6px; cursor: pointer; display: flex; gap: 12px; flex-wrap: wrap;
}
#session-list li:hover { border-color: var(--accent); }
#session-list li.selected { border-color: var(--accent); background: #eef3fb; }
#session-list .sid { font-family: ui-monospace, Menlo, Consolas, monospace; }
#session-list .meta { color: var(--muted); font-size: 12px; }
.badge { font-size: 11px; padding: 1px 8px; border-radius: 10px; background: #fdecea; color: var(--bad); }
.badge.idle { background: #e8f2ea; color: var(--ok); }
#session-detail { display: none; }
#detail-header { color: var(--muted); font-size: 12px; margin-bottom: 8px; word-break: break-all; }
.viewtabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
.viewtabs button {
  border: 1px solid var(--line); background: var(--panel); padding: 4px 12px;
  border-radius: 6px; cursor: pointer; font-size: 13px;
}
.viewtabs button.active { background: var(--accent); color: #fff; border-color: var(--accent); }
.view { display: none; overflow-x: auto; }
.view.active { display: block; }
table { border-collapse: collapse; width: 100%; font-size: 13px; }
th, td { border: 1px solid var(--line); padding: 5px 9px; text-align: left; vertical-align: top; }
th { background: #f0f3f7; white-space: nowrap; }
td { word-break: break-word; }
.empty { color: var(--muted); padding: 10px 0; }
label.toggle { display: inline-flex; gap: 6px; align-items: center; font-size: 13px; cursor: pointer; }
#composition-editor {
  width: 100%; min-height: 320px; resize: vertical; margin-top: 10px;
  font: 13px/1.5 ui-monospace, Menlo, Consolas, monospace;
  border: 1px solid var(--line); border-radius: 8px; padding: 10px;
}
#verify-result { margin-top: 10px; white-space: pre-wrap; display: none; padding: 8px 14px; border-radius: 8px; }
#verify-result.ok { display: block; background: #e8f2ea; color: var(--ok); border: 1px solid #bcd9c2; }
#verify-result.bad { display: block; background: #fdecea; color: var(--bad); border: 1px solid #f5c6c0; }
.hint { color: var(--muted); font-size: 12px; margin-top: 8px; }
pre.dump {
  background: #f0f3f7; border: 1px solid var(--line); border-radius: 8px;
  padding: 10px; font-size: 12px; overflow-x: auto; display: none; margin: 10px 0 0;
}
/* it38 停 2:写面(--web-write)才出现聊天/审批控件;只读面 body 无 web-write 类 */
body:not(.web-write) #tab-chat,
body:not(.web-write) #pane-chat,
body:not(.web-write) #approval-overlay { display: none; }
#chat-log {
  border: 1px solid var(--line); border-radius: 8px; background: #fbfcfd;
  height: 46vh; min-height: 220px; overflow-y: auto; padding: 10px; margin-top: 10px;
}
.msg {
  margin: 6px 0; padding: 6px 10px; border-radius: 8px; max-width: 94%;
  width: fit-content; white-space: pre-wrap; word-break: break-word;
}
.msg.user { background: #eef3fb; margin-left: auto; }
.msg.assistant { background: #fff; border: 1px solid var(--line); }
.msg.tool { background: #f6f7f9; color: var(--muted); font: 12px/1.5 ui-monospace, Menlo, Consolas, monospace; }
.msg.question { background: #fff8e6; border: 1px solid #f0d9a0; }
.msg.sys { color: var(--muted); font-size: 12px; }
#chat-input {
  width: 100%; min-height: 64px; resize: vertical; border: 1px solid var(--line);
  border-radius: 8px; padding: 8px; font: inherit;
}
#approval-overlay {
  background: #fff8e6; border: 1px solid #f0d9a0; border-radius: 8px;
  padding: 10px 12px; margin-top: 10px;
}
#approval-overlay .pending { border-top: 1px dashed #e6cfa0; padding-top: 8px; margin-top: 8px; }
#approval-overlay .pending:first-child { border-top: none; padding-top: 0; margin-top: 0; }
#chat-state.armed { background: #fdecea; color: var(--bad); }
</style>
</head>
<body>
<!-- javanatic-workbench-ui -->
<header>
  <h1>Javanatic Workbench</h1>
  <span class="sub">本地回环工作台（127.0.0.1 · 单用户 · W5）——会话观察 + 组合编辑 + 聊天/审批（--web-write）</span>
</header>
<nav>
  <button id="tab-sessions" class="active" type="button">会话</button>
  <button id="tab-composition" type="button">组合编辑器</button>
  <button id="tab-chat" type="button">聊天</button>
</nav>
<main>
  <div id="error-bar" role="alert"></div>

  <section id="pane-sessions" class="tab active">
    <div class="panel">
      <div class="row">
        <button id="refresh-sessions" class="action" type="button">刷新清单</button>
        <span class="hint">workbench/sessionsList（max=50）——落盘事实，只读</span>
      </div>
      <ul id="session-list"></ul>
      <div id="sessions-empty" class="empty">暂无会话——点「刷新清单」加载。</div>
    </div>
    <div id="session-detail" class="panel">
      <div id="detail-header"></div>
      <div class="row" style="margin-bottom:8px">
        <label class="toggle"><input type="checkbox" id="tail-toggle"> tail 跟随（2s 轮询增量）</label>
        <span class="hint">workbench/sessionTail——游标 = nextSeq</span>
      </div>
      <div class="viewtabs">
        <button id="view-turns" type="button">轮次</button>
        <button id="view-tools" type="button">工具</button>
        <button id="view-usage" type="button">用量</button>
        <button id="view-timeline" type="button" class="active">时间线</button>
        <button id="view-messages" type="button">消息</button>
      </div>
      <div id="viewbody-turns" class="view"></div>
      <div id="viewbody-tools" class="view"></div>
      <div id="viewbody-usage" class="view"></div>
      <div id="viewbody-timeline" class="view active"></div>
      <div id="viewbody-messages" class="view"></div>
    </div>
  </section>

  <section id="pane-composition" class="tab">
    <div class="panel">
      <div class="row">
        <button id="load-dump" class="ghost" type="button">载入当前组合 dump（对照）</button>
        <button id="verify-composition" class="action" type="button">保存前校验</button>
        <button id="download-profile" class="ghost" type="button">下载 profile.yml</button>
      </div>
      <pre id="dump-view" class="dump"></pre>
      <textarea id="composition-editor" spellcheck="false"
        placeholder="在此编辑完整 profile YAML（name / policy / bundles / rows）"></textarea>
      <div id="verify-result" role="status"></div>
      <div class="hint">
        编辑对象是完整 profile YAML；dump 是组合期行序投影（含禁用行注解、脱敏），供对照。
        校验 = 临时 profile 干跑 --verify（不触碰已落盘 profile）；下载经浏览器 Blob 落盘、不经 server——
        保存到 ~/.harness/profiles/&lt;name&gt;/profile.yml 由你手动完成，新会话生效（无热重载）。
      </div>
    </div>
  </section>

  <section id="pane-chat" class="tab">
    <div class="panel">
      <div class="row">
        <button id="chat-new" class="action" type="button">新会话（以输入框消息发起）</button>
        <select id="chat-sessions" aria-label="载入已有会话"></select>
        <button id="chat-attach" class="ghost" type="button">载入</button>
        <span id="chat-state" class="badge idle">空闲</span>
        <button id="chat-cancel" class="ghost" type="button">取消在途轮</button>
      </div>
      <div id="chat-session" class="hint">尚未绑定会话——输入消息后点「新会话」，或选择既有会话「载入」。</div>
      <div id="chat-log" role="log" aria-live="polite"></div>
      <div id="approval-overlay" role="region" aria-label="待审批请求">
        <div class="hint">等待审批 —— 提示条接管输入区：Enter 允许 / Escape 拒绝（不打断会话，日志仍可滚动）。</div>
        <div id="approval-list"></div>
      </div>
      <div class="row" id="chat-compose" style="margin-top:10px">
        <textarea id="chat-input" placeholder="输入消息；Enter 发送，Shift+Enter 换行（IME 组词中不会误发）"></textarea>
      </div>
      <div class="row" style="margin-top:8px">
        <button id="chat-send" class="action" type="button">发送</button>
        <span class="hint">session/start · session/send · session/cancel · approval/respond；事件流 /events?session=（浏览器原生重连）</span>
      </div>
    </div>
  </section>
</main>
<script>
"use strict";
// 写面开关:WorkbenchUi 服务期替换哨兵(--web-write 时 true)。只读面零写控件、零 SSE。
const WEB_WRITE = false;
document.body.classList.toggle("web-write", WEB_WRITE);
// ────────── RPC helper：同源 POST "/"，JSON-RPC 2.0（零 CORS） ──────────
let rpcId = 0;
async function rpc(method, params) {
  const body = { jsonrpc: "2.0", id: ++rpcId, method };
  if (params !== undefined) { body.params = params; }
  const res = await fetch("/", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body)
  });
  const json = await res.json();
  if (json.error) {
    const err = new Error(json.error.message + "（code " + json.error.code + "）");
    err.code = json.error.code;
    throw err;
  }
  return json.result;
}

// ────────── DOM helper：动态内容一律 textContent/createElement（零注入面） ──────────
function el(tag, text, className) {
  const node = document.createElement(tag);
  if (text !== undefined && text !== null) { node.textContent = String(text); }
  if (className) { node.className = className; }
  return node;
}
function clear(node) { while (node.firstChild) { node.removeChild(node.firstChild); } }
function showError(message) {
  const bar = document.getElementById("error-bar");
  bar.textContent = message;
  bar.style.display = "block";
}
function clearError() { document.getElementById("error-bar").style.display = "none"; }
function fmtTime(millis) {
  if (!millis) { return "—"; }
  return new Date(millis).toLocaleString();
}
function text(value) { return value === undefined || value === null ? "—" : String(value); }

// 通用表格渲染：rows = 对象数组，columns = [键, 表头][]
function renderTable(container, rows, columns) {
  clear(container);
  if (!rows || rows.length === 0) {
    container.appendChild(el("div", "（空）", "empty"));
    return;
  }
  const table = el("table");
  const thead = el("thead");
  const headRow = el("tr");
  columns.forEach(([, label]) => headRow.appendChild(el("th", label)));
  thead.appendChild(headRow);
  table.appendChild(thead);
  const tbody = el("tbody");
  rows.forEach(row => {
    const tr = el("tr");
    columns.forEach(([key]) => {
      const value = row[key];
      tr.appendChild(el("td", typeof value === "object" && value !== null
        ? JSON.stringify(value) : text(value)));
    });
    tbody.appendChild(tr);
  });
  table.appendChild(tbody);
  container.appendChild(table);
}

// ────────── 页签 ──────────
const TABS = ["sessions", "composition", "chat"];
function switchTab(name) {
  TABS.forEach(tab => {
    document.getElementById("tab-" + tab).classList.toggle("active", tab === name);
    document.getElementById("pane-" + tab).classList.toggle("active", tab === name);
  });
  if (name !== "sessions") { stopTail(); }
  if (name === "chat" && WEB_WRITE) { loadChatSessions(); }
}
TABS.forEach(tab =>
  document.getElementById("tab-" + tab).addEventListener("click", () => switchTab(tab)));

// ────────── 会话清单 ──────────
async function loadSessions() {
  clearError();
  try {
    const result = await rpc("workbench/sessionsList", { max: 50 });
    const list = document.getElementById("session-list");
    clear(list);
    const empty = document.getElementById("sessions-empty");
    const sessions = result.sessions || [];
    empty.style.display = sessions.length === 0 ? "block" : "none";
    if (sessions.length === 0) { empty.textContent = "暂无会话（total=" + text(result.total) + "）。"; }
    sessions.forEach(summary => {
      const li = el("li");
      li.appendChild(el("span", summary.id, "sid"));
      li.appendChild(el("span", "事件 " + text(summary.eventCount)
        + " · 创建 " + fmtTime(summary.createdAt)
        + " · 最近 " + fmtTime(summary.lastActivityMillis), "meta"));
      li.appendChild(el("span", summary.busy ? "写者占用" : "空闲",
        summary.busy ? "badge" : "badge idle"));
      li.addEventListener("click", () => selectSession(summary.id, li));
      list.appendChild(li);
    });
  } catch (e) { showError("会话清单加载失败: " + e.message); }
}
document.getElementById("refresh-sessions").addEventListener("click", loadSessions);

// ────────── 单会话五视图 ──────────
const state = { session: null, views: null, lastSeq: -1, timer: null };
const VIEW_NAMES = ["turns", "tools", "usage", "timeline", "messages"];

async function selectSession(id, li) {
  stopTail();
  document.getElementById("tail-toggle").checked = false;
  clearError();
  state.session = id;
  state.lastSeq = -1;
  document.querySelectorAll("#session-list li").forEach(n => n.classList.remove("selected"));
  if (li) { li.classList.add("selected"); }
  try {
    const views = await rpc("workbench/sessionViews", { session: id });
    state.views = views;
    document.getElementById("session-detail").style.display = "block";
    const h = views.header || {};
    document.getElementById("detail-header").textContent =
      "会话 " + text(h.id) + " · 创建 " + fmtTime(h.createdAt)
      + " · 版本 " + text(h.version) + " · seed " + text(h.seedLength);
    renderViews(views);
    switchView("timeline");
  } catch (e) { showError("会话视图加载失败: " + e.message); }
}

function renderViews(views) {
  renderTable(document.getElementById("viewbody-turns"), views.turns,
    [["turn", "轮"], ["open", "进行中"], ["startTime", "开始"], ["endTime", "结束"],
     ["endReason", "收尾"], ["steps", "步数"], ["toolCalls", "工具调用"]]);
  const toolRows = [];
  (views.tools || []).forEach(step => {
    (step.pairs || []).forEach(pair => toolRows.push({
      turn: step.turn, step: step.step, name: pair.name,
      arguments: pair.arguments, isError: pair.isError,
      durationMillis: pair.durationMillis
    }));
    (step.orphans || []).forEach(orphan => toolRows.push({
      turn: step.turn, step: step.step, name: "(孤儿调用)",
      arguments: orphan.arguments, isError: "—", durationMillis: "—"
    }));
  });
  renderTable(document.getElementById("viewbody-tools"), toolRows,
    [["turn", "轮"], ["step", "步"], ["name", "工具"], ["arguments", "参数"],
     ["isError", "错误"], ["durationMillis", "耗时(ms)"]]);
  renderUsage(views.usage);
  renderTable(document.getElementById("viewbody-timeline"), views.timeline,
    [["seq", "seq"], ["time", "时间"], ["type", "事件"], ["recognized", "识别"], ["detail", "详情"]]);
  const messageRows = (views.messages || []).map(m => ({
    kind: m.kind,
    source: m.source ? JSON.stringify(m.source) : "—",
    blocks: (m.blocks || []).map(b => b.type).join(", ")
  }));
  renderTable(document.getElementById("viewbody-messages"), messageRows,
    [["kind", "角色"], ["source", "来源"], ["blocks", "块类型"]]);
}

function renderUsage(usage) {
  const container = document.getElementById("viewbody-usage");
  clear(container);
  if (!usage) { container.appendChild(el("div", "（空）", "empty")); return; }
  const total = usage.total || {};
  container.appendChild(el("div", "总计：输入 " + text(total.inputTokens)
    + " · 输出 " + text(total.outputTokens) + " · 推理 " + text(total.reasoningTokens)));
  const rows = (usage.perTurn || []).map(item => ({
    turn: item.turn,
    inputTokens: item.usage ? item.usage.inputTokens : "—",
    outputTokens: item.usage ? item.usage.outputTokens : "—",
    reasoningTokens: item.usage ? item.usage.reasoningTokens : "—"
  }));
  renderTable(container, rows,
    [["turn", "轮"], ["inputTokens", "输入"], ["outputTokens", "输出"], ["reasoningTokens", "推理"]]);
}

function switchView(name) {
  VIEW_NAMES.forEach(v => {
    document.getElementById("view-" + v).classList.toggle("active", v === name);
    document.getElementById("viewbody-" + v).classList.toggle("active", v === name);
  });
}
VIEW_NAMES.forEach(v =>
  document.getElementById("view-" + v).addEventListener("click", () => switchView(v)));

// ────────── tail 轮询（2s；游标 = nextSeq；错误即停） ──────────
function stopTail() {
  if (state.timer !== null) { clearInterval(state.timer); state.timer = null; }
}
async function tailOnce() {
  if (!state.session) { return; }
  try {
    const result = await rpc("workbench/sessionTail",
      { session: state.session, lastSeq: state.lastSeq });
    state.lastSeq = result.nextSeq;
    const events = result.events || [];
    if (events.length > 0) {
      const body = document.getElementById("viewbody-timeline");
      const table = body.querySelector("table");
      if (table) {
        const tbody = table.querySelector("tbody");
        events.forEach(entry => {
          const tr = el("tr");
          [entry.seq, entry.time, entry.type, entry.recognized, entry.detail].forEach(value =>
            tr.appendChild(el("td", typeof value === "object" && value !== null
              ? JSON.stringify(value) : text(value))));
          tbody.appendChild(tr);
        });
      } else {
        renderTable(body, events,
          [["seq", "seq"], ["time", "时间"], ["type", "事件"], ["recognized", "识别"], ["detail", "详情"]]);
      }
      switchView("timeline");
    }
  } catch (e) {
    stopTail();
    document.getElementById("tail-toggle").checked = false;
    showError("tail 轮询已停止: " + e.message);
  }
}
document.getElementById("tail-toggle").addEventListener("change", event => {
  clearError();
  if (event.target.checked) {
    if (!state.session) {
      event.target.checked = false;
      showError("先选择一个会话再开启 tail 跟随。");
      return;
    }
    state.timer = setInterval(tailOnce, 2000);
    tailOnce();
  } else {
    stopTail();
  }
});

// ────────── 组合编辑器 ──────────
const PROFILE_SKELETON = "name: my-profile\npolicy: standard\nbundles: [base]\nrows: []\n";
document.getElementById("composition-editor").value = PROFILE_SKELETON;

document.getElementById("load-dump").addEventListener("click", async () => {
  clearError();
  try {
    const result = await rpc("workbench/compositionDump");
    const view = document.getElementById("dump-view");
    view.textContent = result.dump;
    view.style.display = "block";
  } catch (e) { showError("组合 dump 加载失败: " + e.message); }
});

document.getElementById("verify-composition").addEventListener("click", async () => {
  clearError();
  const box = document.getElementById("verify-result");
  box.className = "";
  box.style.display = "none";
  const yaml = document.getElementById("composition-editor").value;
  try {
    const result = await rpc("workbench/verifyComposition", { yaml });
    if (result.ok) {
      box.textContent = "校验通过——可下载后手动保存到 ~/.harness/profiles/<name>/profile.yml";
      box.className = "ok";
    } else {
      box.textContent = "校验未通过（" + (result.violations || []).length + " 项违规）：\n"
        + (result.violations || []).map((v, i) => (i + 1) + ". " + v).join("\n");
      box.className = "bad";
    }
  } catch (e) { showError("校验请求失败: " + e.message); }
});

// T3 增强：Blob + download 属性——浏览器端落盘，不经 server（零写面承诺）
document.getElementById("download-profile").addEventListener("click", () => {
  clearError();
  const yaml = document.getElementById("composition-editor").value;
  const blob = new Blob([yaml], { type: "application/yaml" });
  const url = URL.createObjectURL(blob);
  const link = el("a");
  link.href = url;
  link.download = "profile.yml";
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
});

// ────────── 聊天 + 审批（写面；只读面不初始化，零 SSE 连接） ──────────
const chat = { session: null, source: null, state: "idle", lastSeq: -1, revision: null, pending: [] };
const CHAT_STATE_LABELS = {
  idle: "空闲", running: "运行中", "waiting-approval": "等待审批",
  "waiting-answer": "等待答复", done: "已收尾"
};

function setChatState(next) {
  chat.state = next;
  const badge = document.getElementById("chat-state");
  badge.textContent = CHAT_STATE_LABELS[next] || next;
  const live = next === "running" || next === "waiting-approval" || next === "waiting-answer";
  badge.className = live ? "badge armed" : "badge idle";
  const busy = next === "running" || next === "waiting-approval";
  document.getElementById("chat-send").disabled = busy;
  document.getElementById("chat-cancel").disabled = !busy;
}

function shorten(value, limit) {
  const s = value === undefined || value === null ? "" : String(value);
  return s.length > limit ? s.slice(0, limit) + " …" : s;
}

function appendChat(kind, body) {
  const log = document.getElementById("chat-log");
  log.appendChild(el("div", body, "msg " + kind));
  log.scrollTop = log.scrollHeight;
}

// 只渲染 text / tool-use 块；tool-result 走事件面（避免与 tool/result 重复）
function appendBlocks(kind, message) {
  ((message && message.content) || []).forEach(block => {
    if (block.kind === "text" && block.text) {
      appendChat(kind, block.text);
    } else if (block.kind === "tool-use") {
      appendChat("tool", "→ " + block.name + " " + shorten(block.arguments, 160));
    }
  });
}

// SSE 帧：有 seq = 日志事实（重开全量重放，按 seq 去重）；kind=approval = 控制帧（不占 seq）
function onSessionEvent(frame) {
  if (!frame || typeof frame.seq !== "number" || frame.seq <= chat.lastSeq) { return; }
  chat.lastSeq = frame.seq;
  const data = frame.data || {};
  switch (frame.type) {
    case "user/message":
      appendBlocks("user", data.message);
      break;
    case "assistant/message":
      appendBlocks("assistant", data.message);
      break;
    case "tool/result":
      if (data.concludesTurn === true) {
        appendChat("question", "模型提问：" + (data.content || ""));
        setChatState("waiting-answer");
      } else {
        appendChat("tool", "← " + shorten(data.content, 200) + (data.isError ? "（错误）" : ""));
      }
      break;
    case "turn/start":
      setChatState("running");
      break;
    case "turn/end":
      const reason = data.reason || {};
      if (reason.kind === "aborted") { appendChat("sys", "已取消（" + text(reason.cause) + "）"); }
      else if (reason.kind === "error") { appendChat("sys", "轮失败：" + text(reason.message)); }
      setChatState("done");
      break;
    default:
      break;
  }
}

function onApprovalFrame(frame) {
  if (frame.revision === chat.revision) { return; }
  chat.revision = frame.revision;
  renderApproval(frame.pending);
  if (chat.pending.length > 0) {
    setChatState("waiting-approval");
  } else if (chat.state === "waiting-approval") {
    setChatState("running");
  }
}

// 审批接管输入区（非模态）：完整替换语义，revision 变更才重绘
function renderApproval(pending) {
  chat.pending = Array.isArray(pending) ? pending : [];
  const overlay = document.getElementById("approval-overlay");
  const list = document.getElementById("approval-list");
  clear(list);
  const open = chat.pending.length > 0;
  overlay.style.display = open ? "block" : "none";
  document.getElementById("chat-compose").style.display = open ? "none" : "flex";
  chat.pending.forEach(entry => {
    const box = el("div", undefined, "pending");
    box.appendChild(el("div",
      (entry.toolName || "工具") + " · 轮 " + text(entry.turn) + " · " + text(entry.session)));
    box.appendChild(el("div", entry.summary || "（无摘要）", "hint"));
    const row = el("div", undefined, "row");
    const allow = el("button", "允许（Enter）", "action");
    allow.type = "button";
    allow.addEventListener("click", () => respondApproval(entry.requestId, true));
    const deny = el("button", "拒绝（Escape）", "ghost");
    deny.type = "button";
    deny.addEventListener("click", () => respondApproval(entry.requestId, false));
    row.appendChild(allow);
    row.appendChild(deny);
    box.appendChild(row);
    list.appendChild(box);
  });
}

async function respondApproval(requestId, allow) {
  clearError();
  try {
    await rpc("approval/respond", { requestId, allow });
  } catch (e) {
    showError("审批结算失败: " + e.message);
  }
}

function closeChatEvents() {
  if (chat.source !== null) {
    chat.source.close();
    chat.source = null;
  }
}

function openChatEvents() {
  if (!chat.session) { return; }
  const source = new EventSource("/events?session=" + encodeURIComponent(chat.session));
  chat.source = source;
  source.onopen = () => clearError();
  source.onmessage = event => {
    let frame;
    try {
      frame = JSON.parse(event.data);
    } catch (e) {
      return;
    }
    if (frame && frame.kind === "approval") {
      onApprovalFrame(frame);
      return;
    }
    onSessionEvent(frame);
  };
  source.onerror = () => {
    // 浏览器原生自动重连（Last-Event-ID 过滤已交付帧）；不重建 source
    if (chat.source === source) {
      showError("事件流断开——浏览器将自动重连（已收事件不会重复渲染）。");
    }
  };
}

function attachChat(sessionId) {
  closeChatEvents();
  chat.session = sessionId;
  chat.lastSeq = -1;
  chat.revision = null;
  clear(document.getElementById("chat-log"));
  renderApproval([]);
  document.getElementById("chat-session").textContent =
    "会话 " + sessionId + " · 事件流 /events?session=" + sessionId;
  setChatState("idle");
  openChatEvents();
}

async function loadChatSessions() {
  try {
    const result = await rpc("workbench/sessionsList", { max: 50 });
    const select = document.getElementById("chat-sessions");
    const current = select.value;
    clear(select);
    (result.sessions || []).forEach(summary => {
      const option = el("option", summary.id);
      option.value = summary.id;
      select.appendChild(option);
    });
    if (current) { select.value = current; }
  } catch (e) { showError("会话清单加载失败: " + e.message); }
}

async function chatStart() {
  const input = document.getElementById("chat-input");
  const message = input.value.trim();
  if (!message) {
    showError("新会话需要先输入第一条消息。");
    return;
  }
  clearError();
  try {
    const result = await rpc("session/start", { text: message });
    input.value = "";
    attachChat(result.sessionId);
    setChatState("running");
  } catch (e) { showError("发起会话失败: " + e.message); }
}

async function chatSend() {
  if (chat.state === "waiting-approval") { return; }
  if (!chat.session) {
    showError("先新建或载入会话。");
    return;
  }
  const input = document.getElementById("chat-input");
  const message = input.value.trim();
  if (!message) { return; }
  clearError();
  try {
    await rpc("session/send", { session: chat.session, text: message });
    input.value = "";
    setChatState("running");
  } catch (e) { showError("发送失败: " + e.message); }
}

async function chatCancel() {
  if (!chat.session) { return; }
  try {
    await rpc("session/cancel", { session: chat.session });
  } catch (e) { showError("取消失败: " + e.message); }
}

function initChat() {
  document.getElementById("approval-overlay").style.display = "none";
  document.getElementById("chat-new").addEventListener("click", chatStart);
  document.getElementById("chat-send").addEventListener("click", chatSend);
  document.getElementById("chat-cancel").addEventListener("click", chatCancel);
  document.getElementById("chat-attach").addEventListener("click", () => {
    const selected = document.getElementById("chat-sessions").value;
    if (selected) {
      attachChat(selected);
    } else {
      showError("先选择一个会话。");
    }
  });
  const input = document.getElementById("chat-input");
  input.addEventListener("keydown", event => {
    // IME 组词中按 Enter 是选词，不是发送（isComposing / keyCode 229 双保险）
    if (event.isComposing || event.keyCode === 229) { return; }
    if (event.key === "Enter" && !event.shiftKey) {
      event.preventDefault();
      chatSend();
    }
  });
  document.addEventListener("keydown", event => {
    if (event.isComposing || event.keyCode === 229) { return; }
    if (chat.pending.length === 0) { return; }
    if (event.key === "Enter") {
      event.preventDefault();
      respondApproval(chat.pending[0].requestId, true);
    } else if (event.key === "Escape") {
      event.preventDefault();
      respondApproval(chat.pending[0].requestId, false);
    }
  });
  setChatState("idle");
}

// 首屏加载会话清单
loadSessions();
if (WEB_WRITE) {
  initChat();
}
</script>
</body>
</html>"
