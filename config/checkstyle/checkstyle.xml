<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- JH 门禁规则：AGENTS.md「编码规范」的可执行子集（阿里手册 applicable 部分）。
     原则：只收当前代码已满足的规则——门禁先绿后严；放宽或收紧须在 PR 里说明理由。 -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- 白空格与行宽 -->
    <module name="FileTabCharacter"/>          <!-- 缩进只允许空格 -->
    <module name="NewlineAtEndOfFile"/>        <!-- 文件恰好一个结尾换行 -->
    <module name="LineLength">                 <!-- 行宽上限：启动时取现有最大行 + 余量 -->
        <property name="max" value="140"/>
    </module>

    <module name="TreeWalker">
        <!-- import 纪律 -->
        <module name="AvoidStarImport"/>       <!-- 禁 * 导入 -->
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>

        <!-- 结构 -->
        <module name="OneTopLevelClass"/>      <!-- 每文件一个顶层类型 -->
        <module name="ModifierOrder"/>         <!-- 修饰符顺序遵循 JLS -->
        <module name="OneStatementPerLine"/>
        <module name="EmptyStatement"/>        <!-- 禁空语句 `;` -->
        <module name="ArrayTypeStyle"/>        <!-- `String[] a` 而非 `String a[]` -->
        <module name="UpperEll"/>              <!-- long 字面量用大写 L -->
        <module name="EqualsHashCode"/>        <!-- 覆写 equals 必须覆写 hashCode（record 自动满足）-->
        <module name="EmptyCatchBlock">        <!-- 空 catch 必须留注释说明吞了什么 -->
            <property name="exceptionVariableName" value="expected|ignored"/>
            <property name="commentFormat" value=".*"/>
        </module>

        <!-- 命名（阿里手册子集；接口/类/enum/record 统一 TypeName）-->
        <module name="TypeName"/>
        <module name="ConstantName"/>          <!-- 常量 UPPER_SNAKE_CASE；enum 成员同规 -->
        <module name="MethodName"/>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="LocalFinalVariableName"/>
    </module>
</module>
