<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      外部消费方示例（it23，指南 docs/embedding.md）：独立工程、独立坐标——
      不继承 harness-parent（继承会把 junit/assertj/jqwik 等测试依赖一起拖进来），
      不进主仓 reactor。构建只依赖坐标解析：
        候选工件：主仓工作树 `mvn install -Dmaven.repo.local=<隔离仓>` →
                  -Dharness.version=0.4.0-SNAPSHOT（candidate-closure 默认生效）
        发布工件：-Dharness.version=0.3.0（Maven Central）；candidate-closure 已随 0.3.0
                  折空，发布腿的 -P '!candidate-closure' 停用保留为 0.4.0 候选前置
    -->
    <groupId>io.github.retreatisadvance.sample</groupId>
    <artifactId>consumer-sample</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>consumer-sample</name>
    <description>外部 Java 接入示例：嵌入 agent、注册自有工具、治理自证</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- 版本单点：0.3.0 = Central 发布件；0.x.0-SNAPSHOT = 工作树 install 的候选件 -->
        <harness.version>0.4.0-SNAPSHOT</harness.version>
        <!--
          shell provider 坐标单点（it25 S-b 改名 harness-shell-bash-local → harness-shell-local）：
            两条腿同用新坐标——0.2.0 起发布件含 harness-shell-local，旧坐标覆写已退役
        -->
        <harness.shell.artifactId>harness-shell-local</harness.shell.artifactId>
    </properties>

    <dependencies>
        <!-- 组合装配面（AppBoot / Policy / YamlRows）及其 compile 依赖 -->
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-bundle-base</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <!-- 嵌入面：Plugin / Runtime / Scope / ServiceKey -->
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-kernel-core</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <!-- 行模型：ConfigRowSpec（dump 的输入） -->
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-kernel-config</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <!-- 工具注册面：ToolRegistry / ToolDefinition / ToolArgs / ToolExecutionResult / ValueSchema -->
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-core-tools</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-core-session</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <!-- 模型面：ToolSchema（schemas() 的返回）与 AbortSignal -->
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-llm-llm</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <!--
          base bundle 的行引用了这些插件，而 harness-bundle-base 只在测试面依赖它们：
          运行闭包（= 组合行引用的插件集）由消费方自持，装配期双向校验会点名缺失项。
        -->
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-core-agent</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-core-system-prompt</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-llm-openai-compat</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-fs-local</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-fs-tool</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>${harness.shell.artifactId}</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-shell-tool</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-session-persistence-jsonl</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-interaction-approval</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-core-preset</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <!-- 0.3.0 折叠（release.md 发布后清单）：skill 三件（it26）/ mcp 四坐标（it27/27.1；
             mcp-mcp 为契约件）/ web 四坐标（it28；web-web 为契约件）/ lsp 三坐标（it29；
             lsp-lsp 为契约件、lsp-tool 进 base bundle、lsp-jdtls 为 Provider 装配件）——
             0.3.0 发布件已含全部行与坐标，自 candidate-closure 折入基础块 -->
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-skill-skill</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-skill-local</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-skill-tool</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-mcp-mcp</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-mcp-stdio</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-mcp-http</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-mcp-tool</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-web-web</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-web-fetch-http</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-web-search-deepseek</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-web-tool</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-lsp-lsp</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-lsp-jdtls</artifactId>
            <version>${harness.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-lsp-tool</artifactId>
            <version>${harness.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          candidate-closure：候选件行集比发布件多出的坐标收在这里（it26 follow-up 起，
          每次 it 交付新坐标先入此 profile，随下一次发布折回上方基础块——0.3.0 已将
          skill 三件 / mcp 四坐标 / web 四坐标 / lsp 三坐标全部折空）。默认
          生效＝候选腿；发布腿经 -P '!candidate-closure' 停用
          （integration/verify-consumer.sh 的 leg()），0.4.0 起新候选坐标入此后
          该停用重新生效——见 docs/release.md 发布后清单「发布腿重指」。
        -->
        <profile>
            <id>candidate-closure</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <!-- it30 jobs 两坐标：jobs-local（行 + Provider）/ jobs-tool（行 + 四工具）。
                     0.4.0 发布时折回基础块（release.md 发布后清单同规）。 -->
                <dependency>
                    <groupId>io.github.retreatisadvance</groupId>
                    <artifactId>harness-jobs-local</artifactId>
                    <version>${harness.version}</version>
                </dependency>
                <dependency>
                    <groupId>io.github.retreatisadvance</groupId>
                    <artifactId>harness-jobs-tool</artifactId>
                    <version>${harness.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
