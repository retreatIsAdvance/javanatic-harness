<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.retreatisadvance</groupId>
        <artifactId>harness-dist-aggregator</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>harness-dist-jh</artifactId>
    <name>harness-dist-jh</name>
    <!-- 无源码的编排模块:jar packaging 仅为满足 moditect「工程 artifact 存在」的前提
         (pom packaging 下该前提直接 NPE);空 jar 不参与镜像。 -->
    <packaging>jar</packaging>

    <properties>
        <!-- 归档基名 = 归档内顶层目录名(解压即用);平台标记由 profile 按 os family 注入 -->
        <jh.archive.name>javanatic-harness-${project.version}-${jh.archive.platform}</jh.archive.name>
    </properties>

    <dependencies>
        <!-- 唯一入口模块:其传递闭包 = 全 reactor 运行时模块 + jackson/snakeyaml -->
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-examples-headless</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 1) jlink module-path 暂存:入口闭包 jar 拷到 target/modules/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>stage-runtime-jars</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 2) jlink 运行时镜像 → target/jlink-image/(bin/jh 唯一入口)。两处非直觉配置,均 it13 实证:
                 a) 不走 bindServices:不装 jmods 的 JDK(JEP 493 linkable runtime,本机 Temurin 25
                    即此形态)拒绝该模式;插件发现改为显式列根,须覆盖 bundle.yml 引用的全部
                    provider 模块,缺失由镜像内 verify 冒烟 fail loud(CI 双 job 兜底)。
                 b) launcher 的 module 取 module/mainClass:moditect 1.2.2 拼接 name=module 而
                    忽略 mainClass,且本模块描述符不带 ModuleMainClass,jlink 要求显式主类。 -->
            <plugin>
                <groupId>org.moditect</groupId>
                <artifactId>moditect-maven-plugin</artifactId>
                <version>1.2.2.Final</version>
                <executions>
                    <execution>
                        <id>create-jh-runtime-image</id>
                        <phase>package</phase>
                        <goals><goal>create-runtime-image</goal></goals>
                        <configuration>
                            <modulePath>
                                <path>${project.build.directory}/modules</path>
                            </modulePath>
                            <modules>
                                <module>io.javanatic.harness.examples.headless</module>
                                <module>io.javanatic.harness.core.plan</module>
                                <module>io.javanatic.harness.core.todo</module>
                                <module>io.javanatic.harness.core.preset</module>
                                <module>io.javanatic.harness.interaction.commands</module>
                                <module>io.javanatic.harness.interaction.ask</module>
                                <module>io.javanatic.harness.sandbox.local</module>
                                <module>io.javanatic.harness.sandbox.policy</module>
                                <module>io.javanatic.harness.shell.docker</module>
                            </modules>
                            <outputDirectory>${project.build.directory}/jlink-image</outputDirectory>
                            <!-- NONE:不带 jars/ 依赖拷贝;null 会令 moditect copyJars NPE -->
                            <jarInclusionPolicy>NONE</jarInclusionPolicy>
                            <!-- JDK 25 jlink 只认 zip-[0-9](数字档已移除);6 = 经典默认档 -->
                            <compression>zip-6</compression>
                            <stripDebug>true</stripDebug>
                            <noHeaderFiles>true</noHeaderFiles>
                            <noManPages>true</noManPages>
                            <launcher>
                                <name>jh</name>
                                <module>io.javanatic.harness.examples.headless/io.javanatic.harness.examples.headless.HeadlessMain</module>
                            </launcher>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 3) tar.gz + zip 归档(解压即用):同一 package 相位,声明序保证在 jlink 之后。
                 模式按目录分档:bin/ 与 lib/(含 jspawnhelper)必须带执行位,其余 0644。
                 平台标记进文件名与归档顶层目录名——镜像与平台绑定,未标记即误下载源。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>archive-runtime-image</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/archive.xml</descriptor>
                            </descriptors>
                            <finalName>${jh.archive.name}</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <!-- conf/security/policy/... 深路径超 ustar 100 字符上限:posix(pax) 扩展头,
                                 bsdtar 与 GNU tar 均原生可解 -->
                            <tarLongFileMode>posix</tarLongFileMode>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 平台标记注入归档名。plexus-utils 在 macOS 上 mac 与 unix family 同时命中(3.3.1 实测),
             故 linux 档再加 name=Linux 收窄保证互斥;windows 只靠 family(name 带版本号不可枚举)。
             三分之外如常暴露未解析占位符 = fail loud,不做静默兜底。 -->
        <profile>
            <id>archive-macos</id>
            <activation><os><family>mac</family><name>Mac OS X</name></os></activation>
            <properties><jh.archive.platform>macos-${os.arch}</jh.archive.platform></properties>
        </profile>
        <profile>
            <id>archive-linux</id>
            <activation><os><family>unix</family><name>Linux</name></os></activation>
            <properties><jh.archive.platform>linux-${os.arch}</jh.archive.platform></properties>
        </profile>
        <profile>
            <id>archive-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties><jh.archive.platform>windows-${os.arch}</jh.archive.platform></properties>
        </profile>
    </profiles>
</project>
