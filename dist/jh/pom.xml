<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.retreatisadvance</groupId>
        <artifactId>harness-dist-aggregator</artifactId>
        <version>0.5.0-SNAPSHOT</version>
    </parent>

    <artifactId>harness-dist-jh</artifactId>
    <name>harness-dist-jh</name>
    <!-- 无源码的编排模块:jar packaging 仅为满足 moditect「工程 artifact 存在」的前提
         (pom packaging 下该前提直接 NPE);空 jar 不参与镜像。 -->
    <packaging>jar</packaging>

    <properties>
        <!-- 归档基名 = 归档内顶层目录名(解压即用);平台标记由 profile 按 os family 注入 -->
        <jh.archive.name>javanatic-harness-${project.version}-${jh.archive.platform}</jh.archive.name>
    </properties>

    <dependencies>
        <!-- 唯一入口模块:其传递闭包 = 全 reactor 运行时模块 + jackson/snakeyaml -->
        <dependency>
            <groupId>io.github.retreatisadvance</groupId>
            <artifactId>harness-examples-headless</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 1) jlink module-path 暂存:入口闭包 jar 拷到 target/modules/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>stage-runtime-jars</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 2) jlink 运行时镜像 → target/jlink-image/(bin/jh 唯一入口)。两处非直觉配置,均 it13 实证:
                 a) 不走 bindServices:不装 jmods 的 JDK(JEP 493 linkable runtime,本机 Temurin 25
                    即此形态)拒绝该模式;插件发现改为显式列根,须覆盖 bundle.yml 引用的全部
                    provider 模块,缺失由镜像内 verify 冒烟 fail loud(CI 双 job 兜底)。
                 b) launcher 的 module 取 module/mainClass:moditect 1.2.2 拼接 name=module 而
                    忽略 mainClass,且本模块描述符不带 ModuleMainClass,jlink 要求显式主类。 -->
            <plugin>
                <groupId>org.moditect</groupId>
                <artifactId>moditect-maven-plugin</artifactId>
                <version>1.2.2.Final</version>
                <executions>
                    <execution>
                        <id>create-jh-runtime-image</id>
                        <phase>package</phase>
                        <goals><goal>create-runtime-image</goal></goals>
                        <configuration>
                            <modulePath>
                                <path>${project.build.directory}/modules</path>
                            </modulePath>
                            <modules>
                                <module>io.javanatic.harness.examples.headless</module>
                                <module>io.javanatic.harness.workbench.projection</module>
                                <module>io.javanatic.harness.core.plan</module>
                                <module>io.javanatic.harness.core.todo</module>
                                <module>io.javanatic.harness.core.preset</module>
                                <module>io.javanatic.harness.interaction.commands</module>
                                <module>io.javanatic.harness.skill.skill</module>
                                <module>io.javanatic.harness.skill.local</module>
                                <module>io.javanatic.harness.skill.tool</module>
                                <module>io.javanatic.harness.mcp</module>
                                <module>io.javanatic.harness.mcp.stdio</module>
                                <module>io.javanatic.harness.mcp.http</module>
                                <module>io.javanatic.harness.mcp.tool</module>
                                <module>io.javanatic.harness.web</module>
                                <module>io.javanatic.harness.web.fetch.http</module>
                                <module>io.javanatic.harness.web.search.deepseek</module>
                                <module>io.javanatic.harness.web.tool</module>
                                <module>io.javanatic.harness.lsp</module>
                                <module>io.javanatic.harness.lsp.jdtls</module>
                                <module>io.javanatic.harness.lsp.tool</module>
                                <module>io.javanatic.harness.jobs</module>
                                <module>io.javanatic.harness.jobs.local</module>
                                <module>io.javanatic.harness.jobs.tool</module>
                                <module>io.javanatic.harness.delegation</module>
                                <module>io.javanatic.harness.delegation.local</module>
                                <module>io.javanatic.harness.delegation.tool</module>
                                <module>io.javanatic.harness.interaction.ask</module>
                                <module>io.javanatic.harness.sandbox.local</module>
                                <module>io.javanatic.harness.sandbox.policy</module>
                                <module>io.javanatic.harness.shell.docker</module>
                                <!-- it34 W2:工作台 TUI + JLine 4 三件套。nativ 必进:
                                     org.jline.terminal 模块描述符硬 requires(非 static),
                                     jlink 全图解析缺之即败(jh 镜像实测);ffm 为 terminal
                                     提供方,两者同进镜像 -->
                                <module>io.javanatic.harness.workbench.tui</module>
                                <module>org.jline.terminal</module>
                                <module>org.jline.terminal.ffm</module>
                                <module>org.jline.nativ</module>
                            </modules>
                            <outputDirectory>${project.build.directory}/jlink-image</outputDirectory>
                            <!-- NONE:不带 jars/ 依赖拷贝;null 会令 moditect copyJars NPE -->
                            <jarInclusionPolicy>NONE</jarInclusionPolicy>
                            <!-- JDK 25 jlink 只认 zip-[0-9](数字档已移除);6 = 经典默认档 -->
                            <compression>zip-6</compression>
                            <stripDebug>true</stripDebug>
                            <noHeaderFiles>true</noHeaderFiles>
                            <noManPages>true</noManPages>
                            <launcher>
                                <name>jh</name>
                                <module>io.javanatic.harness.examples.headless/io.javanatic.harness.examples.headless.HeadlessMain</module>
                            </launcher>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 2.5) launcher 烧入 native-access VM 选项:moditect 1.2.2 的 Launcher 仅
                 name/module/mainClass、core 命令无 jlink options 透传 ⇒ jlink 官方
                 add-options 插件不可达 ⇒ 后置替换 launcher 空行(jdk.jlink
                 DefaultImageBuilder 模板实测:sh 三平台全生成、.bat 仅 Windows)。
                 授权清单须含实际调用受限方法的模块:org.jline.nativ 的
                 System::load(JNI)与 org.jline.terminal.ffm,缺其一启动即 WARNING。
                 同 package 相位,声明序保证在 moditect 之后、assembly 之前;
                 token 缺失 fail loud(替换不到 = 镜像缺烧入,停 3 冒烟兜底)。
                 ant replace 经 java.nio 临时文件改写会剥执行位(600),replace 后
                 chmod 755 恢复(java/keytool 同为 755,直接执行 ./bin/jh 依赖此位)。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>burn-native-access-into-launcher-sh</id>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <replace file="${project.build.directory}/jlink-image/bin/jh"
                                         token="JLINK_VM_OPTIONS="
                                         value="JLINK_VM_OPTIONS=&quot;--enable-native-access=org.jline.terminal.ffm,org.jline.nativ&quot;"
                                         failOnNoReplacements="true"/>
                                <chmod file="${project.build.directory}/jlink-image/bin/jh" perm="755"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 3) tar.gz + zip 归档(解压即用):同一 package 相位,声明序保证在 jlink 之后。
                 模式按目录分档:bin/ 与 lib/(含 jspawnhelper)必须带执行位,其余 0644。
                 平台标记进文件名与归档顶层目录名——镜像与平台绑定,未标记即误下载源。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>archive-runtime-image</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/archive.xml</descriptor>
                            </descriptors>
                            <finalName>${jh.archive.name}</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <!-- conf/security/policy/... 深路径超 ustar 100 字符上限:posix(pax) 扩展头,
                                 bsdtar 与 GNU tar 均原生可解 -->
                            <tarLongFileMode>posix</tarLongFileMode>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 平台标记注入归档名。plexus-utils 在 macOS 上 mac 与 unix family 同时命中(3.3.1 实测),
             故 linux 档再加 name=Linux 收窄保证互斥;windows 只靠 family(name 带版本号不可枚举)。
             三分之外如常暴露未解析占位符 = fail loud,不做静默兜底。 -->
        <profile>
            <id>archive-macos</id>
            <activation><os><family>mac</family><name>Mac OS X</name></os></activation>
            <properties><jh.archive.platform>macos-${os.arch}</jh.archive.platform></properties>
        </profile>
        <profile>
            <id>archive-linux</id>
            <activation><os><family>unix</family><name>Linux</name></os></activation>
            <properties><jh.archive.platform>linux-${os.arch}</jh.archive.platform></properties>
        </profile>
        <profile>
            <id>archive-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties><jh.archive.platform>windows-${os.arch}</jh.archive.platform></properties>
            <!-- Windows 面 launcher 烧入:.bat 仅 isWindows() 生成(DefaultImageBuilder
                 实测),烧入随平台档案走;token 缺失 fail loud,与 sh 同规则;授权清单
                 与 sh 同双模块(org.jline.nativ 的 System::load + org.jline.terminal.ffm)。 -->
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>burn-native-access-into-launcher-bat</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <replace file="${project.build.directory}/jlink-image/bin/jh.bat"
                                                 token="set JLINK_VM_OPTIONS="
                                                 value="set JLINK_VM_OPTIONS=--enable-native-access=org.jline.terminal.ffm,org.jline.nativ"
                                                 failOnNoReplacements="true"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
