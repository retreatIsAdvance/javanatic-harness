# 编辑器基线；格式执法由 spotless/checkstyle（mvn validate）与 CI 兜底
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.java]
indent_style = space
indent_size = 4

[*.{xml,yml,yaml}]
indent_style = space
indent_size = 2
